# Blackbox logs (large)
aircraft/*/logs/*
!aircraft/*/logs/.gitkeep

# Firmware binaries
*.hex
*.bin
*.dfu

# Large STL archives
*.zip
*.7z
*.rar

# FreeCAD backups, Python bytecode
*.FCBak
*.FCStd1
*.replaced.FCStd
__pycache__/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~

# Local agent/tool state
.claude/settings.local.json

# Scratch
scratch/
